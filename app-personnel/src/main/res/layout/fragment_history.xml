<?xml version="1.0" encoding="utf-8"?>
<!--
    The cleaner's task history: every assignment this account has ever been
    given, read from the on-device database and narrowed by a status filter.

    The filter row uses custom tab pill containers. There is no bulk delete or trash
    here on purpose: an assignment is server-owned, so deleting it locally would
    only hide work that is still on this cleaner's hands.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Report History"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="@color/green" />

    </FrameLayout>

    <!-- Search and sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/green" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints="none"
                android:background="@android:color/transparent"
                android:hint="@string/history_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/green"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/history_clear_search"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:visibility="gone"
                app:tint="@color/green" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/search_bar_background"
            android:contentDescription="@string/history_sort"
            android:src="@drawable/sort"
            app:tint="@color/green" />
    </LinearLayout>

    <!-- Custom Tab Pill Container -->
    <HorizontalScrollView
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabPillContainer"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:background="@drawable/white_pill_background"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabHistoryAll"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_all"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/active_pill_background"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryActive"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_active"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryAssigned"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_assigned"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryAccepted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_accepted"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryInProgress"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_in_progress"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryUnderApproval"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_under_approval"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryCompleted"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_completed"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tabHistoryCancelled"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="90dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/filter_cancelled"
                android:textColor="@color/green"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historyRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="24dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <ProgressBar
            android:id="@+id/historyProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/green"
            android:visibility="gone" />

        <TextView
            android:id="@+id/historyEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/history_empty"
            android:textColor="@color/green"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>