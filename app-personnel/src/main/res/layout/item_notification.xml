<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/notifCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:strokeColor="#06402B"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/notifCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:buttonTint="@color/green" />

        <View
            android:id="@+id/notifUnreadDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/notification_unread_dot"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_notification"
            app:tint="@color/green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notifTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notification title"
                android:textColor="@color/green"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notifMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Notification message"
                android:textColor="@color/green"
                android:textSize="14sp"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/notifReportId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Task: —"
                android:textColor="@color/green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.75"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notifTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Time"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:alpha="0.6" />
        </LinearLayout>

        <!--
            Per-row delete, plus restore for rows in Trash.

            The two buttons are mutually exclusive: a row in the All tab can only be
            trashed, and a row in Trash can only be restored or destroyed. Their
            visibility is driven by the adapter's current tab.
        -->
        <ImageButton
            android:id="@+id/notifRestoreBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Restore notification"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_restore"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/notifDeleteBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete notification"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete_trash" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
