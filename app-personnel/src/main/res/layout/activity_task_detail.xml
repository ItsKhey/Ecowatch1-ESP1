<?xml version="1.0" encoding="utf-8"?>
<!--
    One cleaning assignment, end to end: what the resident reported, the photos
    the cleaner has recorded, and the next action the server will allow.

    Every action button is driven by the server's permissions object, so a button
    that is shown is one the backend will accept.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/taskDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backgroundImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"

        android:contentDescription="@null" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/detailHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/taskBackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/task_back"
            android:src="@drawable/ic_back"
            app:tint="@color/green" />

        <TextView
            android:id="@+id/detailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/task_detail_title"
            android:textColor="@color/green"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/task_status_placeholder"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scrollable body -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/detailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/detailActionBar"
        app:layout_constraintTop_toBottomOf="@id/detailHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:background="@color/white">

            <TextView
                android:id="@+id/detailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"
                tools:text="Report RPT-123 · Assigned Mar 3, 2026" />

            <!--
                Administrator note. This is the same report field an assignment
                writes its instructions into and a revision request overwrites
                with the reviewer's reply, so after a revision the cleaner reads
                the reason here instead of only in the notification.
            -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/adminNoteCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF6E0"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#C58A00"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/adminNoteTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_note_section"
                        android:textColor="#8A5B00"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/adminNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#6B4E00"
                        android:textSize="14sp"
                        tools:text="Please re-photograph the area; the waste is still visible on the left." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Report card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#06402B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/reportTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="Illegal dumping near the creek" />

                    <TextView
                        android:id="@+id/reportCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/faint_green_color"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Residual" />

                    <!--
                        How big the job is, and what the administrator sent to
                        deal with it. The crew and truck rows only appear when
                        there are ones: a small report is handled by a single
                        cleaner and has neither.
                    -->
                    <TextView
                        android:id="@+id/reportWasteScale"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_status_pill"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/green"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="Large-Scale Waste" />

                    <LinearLayout
                        android:id="@+id/reportDispatchDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/reportAssignedTeamRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/reportAssignedTeamLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/assigned_team_label"
                                android:textColor="@color/faint_green_color"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/reportAssignedTeam"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Northside Crew" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/reportAssignedVehicleRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/reportAssignedVehicleLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/assigned_vehicle_label"
                                android:textColor="@color/faint_green_color"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/reportAssignedVehicle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/green"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="ABC-123 (Garbage Truck)" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/reportImage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="12dp"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/RoundedImage" />

                    <TextView
                        android:id="@+id/reportDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/green"
                        android:textSize="14sp"
                        android:alpha="0.9"
                        tools:text="A pile of garbage has been sitting by the creek for days." />

                    <TextView
                        android:id="@+id/reportLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/faint_green_color"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="Location: 14.5995, 120.9842" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progress card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#06402B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/task_progress_section"
                        android:textColor="@color/green"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/timelineAccepted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/faint_green_color"
                        android:textSize="13sp"
                        tools:text="Accepted: Mar 3, 2026" />

                    <TextView
                        android:id="@+id/timelineStarted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/faint_green_color"
                        android:textSize="13sp"
                        tools:text="Started: Mar 3, 2026" />

                    <TextView
                        android:id="@+id/timelineCompleted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/faint_green_color"
                        android:textSize="13sp"
                        tools:text="Completed: Mar 3, 2026" />

                    <TextView
                        android:id="@+id/timelineNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/green"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Notes: Removed three sacks of residual waste." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BEFORE evidence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/evidence_before"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/beforeRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/evidence_required"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/beforeHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/evidence_before_hint"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/beforeRecycler"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                tools:listitem="@layout/item_photo_thumbnail" />

            <!-- AFTER evidence -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/evidence_after"
                    android:textColor="@color/green"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/afterRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/evidence_required"
                    android:textColor="@color/green"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/afterHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/evidence_after_hint"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/afterRecycler"
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                tools:listitem="@layout/item_photo_thumbnail" />

            <!-- Completion notes, only while the task can still be completed -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/taskNotesLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/task_notes_hint"
                android:visibility="gone"
                app:hintTextColor="@color/green">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/taskNotesInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:textColor="@color/green" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/actionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/faint_green_color"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Add at least one before photo to start cleaning." />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Action bar -->
    <LinearLayout
        android:id="@+id/detailActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/task_accept"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/task_start"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComplete"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/task_complete"
            android:textSize="15sp"
            android:visibility="gone"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/detailProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/green"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
